// inspector: units. Each unit is a factor to SI and its dimension (powers of
// length, mass, time, temperature and angle), so a value typed in one unit
// goes into a field in another: "3 ft" into a field in mm is 914.4. Units
// combine with · * / and powers: "kN·m", "m/s", "m^3/s", "mm²".
//
// Author: Alexius Academia
// Date: 2026-10-25

// A unit: SI value = number × factor + offset. Only temperatures have an
// offset (°C and °F).
struct Unit {
    factor: Float
    dims: [Int]
    offset: Float = 0.0
}

// The dimensions, in the order of `dims`.
let dimSymbols = ["m", "kg", "s", "K", "rad"]

fn dimsOf(_ l: Int, _ m: Int, _ t: Int, _ k: Int, _ a: Int) -> [Int] {
    [l, m, t, k, a]
}

let noDims = [0, 0, 0, 0, 0]

// Every unit by its name.
let unitTable: [String: Unit] = makeUnits()

fn makeUnits() -> [String: Unit] {
    var u: [String: Unit] = [:]
    let length = dimsOf(1, 0, 0, 0, 0)
    let area = dimsOf(2, 0, 0, 0, 0)
    let volume = dimsOf(3, 0, 0, 0, 0)
    let mass = dimsOf(0, 1, 0, 0, 0)
    let time = dimsOf(0, 0, 1, 0, 0)
    let force = dimsOf(1, 1, -2, 0, 0)
    let pressure = dimsOf(-1, 1, -2, 0, 0)
    let energy = dimsOf(2, 1, -2, 0, 0)
    let power = dimsOf(2, 1, -3, 0, 0)
    let flow = dimsOf(3, 0, -1, 0, 0)
    let speed = dimsOf(1, 0, -1, 0, 0)
    let angle = dimsOf(0, 0, 0, 0, 1)
    let temperature = dimsOf(0, 0, 0, 1, 0)
    let lbf = 4.4482216152605
    let psi = 6894.757293168361
    for (name, f) in [("m", 1.0), ("km", 1000.0), ("cm", 0.01), ("mm", 0.001), ("um", 1e-6), ("µm", 1e-6),
                      ("in", 0.0254), ("\"", 0.0254), ("ft", 0.3048), ("'", 0.3048), ("yd", 0.9144),
                      ("mi", 1609.344), ("nmi", 1852.0)] {
        u[name] = Unit(factor: f, dims: length)
    }
    for (name, f) in [("ha", 1e4), ("acre", 4046.8564224)] {
        u[name] = Unit(factor: f, dims: area)
    }
    for (name, f) in [("L", 0.001), ("l", 0.001), ("mL", 1e-6), ("ml", 1e-6), ("gal", 0.003785411784)] {
        u[name] = Unit(factor: f, dims: volume)
    }
    for (name, f) in [("kg", 1.0), ("g", 0.001), ("mg", 1e-6), ("t", 1000.0), ("tonne", 1000.0),
                      ("lb", 0.45359237), ("oz", 0.028349523125), ("slug", 14.593902937206364)] {
        u[name] = Unit(factor: f, dims: mass)
    }
    for (name, f) in [("s", 1.0), ("ms", 0.001), ("min", 60.0), ("h", 3600.0), ("hr", 3600.0), ("day", 86400.0)] {
        u[name] = Unit(factor: f, dims: time)
    }
    for (name, f) in [("N", 1.0), ("kN", 1e3), ("MN", 1e6), ("lbf", lbf), ("kip", lbf * 1000.0),
                      ("kgf", 9.80665), ("tf", 9806.65)] {
        u[name] = Unit(factor: f, dims: force)
    }
    for (name, f) in [("Pa", 1.0), ("kPa", 1e3), ("MPa", 1e6), ("GPa", 1e9), ("bar", 1e5), ("mbar", 100.0),
                      ("atm", 101325.0), ("psi", psi), ("ksi", psi * 1000.0), ("psf", 47.88025898033584),
                      ("ksf", 47880.25898033584), ("mmHg", 133.322387415)] {
        u[name] = Unit(factor: f, dims: pressure)
    }
    for (name, f) in [("J", 1.0), ("kJ", 1e3), ("MJ", 1e6), ("Wh", 3600.0), ("kWh", 3.6e6), ("cal", 4.184),
                      ("kcal", 4184.0), ("BTU", 1055.05585262)] {
        u[name] = Unit(factor: f, dims: energy)
    }
    for (name, f) in [("W", 1.0), ("kW", 1e3), ("MW", 1e6), ("hp", 745.6998715822702)] {
        u[name] = Unit(factor: f, dims: power)
    }
    for (name, f) in [("cfs", 0.028316846592), ("gpm", 6.30901964e-5), ("MGD", 0.0438126363888)] {
        u[name] = Unit(factor: f, dims: flow)
    }
    for (name, f) in [("mph", 0.44704), ("knot", 1852.0 / 3600.0), ("kph", 1000.0 / 3600.0)] {
        u[name] = Unit(factor: f, dims: speed)
    }
    for (name, f) in [("rad", 1.0), ("deg", pi / 180.0), ("°", pi / 180.0), ("rev", 2.0 * pi)] {
        u[name] = Unit(factor: f, dims: angle)
    }
    u["K"] = Unit(factor: 1.0, dims: temperature)
    for name in ["°C", "degC", "C"] {
        u[name] = Unit(factor: 1.0, dims: temperature, offset: 273.15)
    }
    for name in ["°F", "degF", "F"] {
        u[name] = Unit(factor: 5.0 / 9.0, dims: temperature, offset: 459.67 * 5.0 / 9.0)
    }
    u["Hz"] = Unit(factor: 1.0, dims: dimsOf(0, 0, -1, 0, 0))
    u["%"] = Unit(factor: 0.01, dims: noDims)
    u["ppm"] = Unit(factor: 1e-6, dims: noDims)
    u
}

// Whether a character can be part of a unit's name.
fn isUnitChar(_ ch: String) -> Bool {
    if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") {
        return true
    }
    ch == "µ" || ch == "°" || ch == "%" || ch == "'" || ch == "\""
}

// A superscript digit's value (² is 2), or nil.
fn superscript(_ ch: String) -> Int? {
    let digits = ["⁰", "¹", "²", "³", "⁴", "⁵", "⁶", "⁷", "⁸", "⁹"]
    digits.index(of: ch)
}

// The dimensions as an SI unit, like "kg·m⁻¹·s⁻²", for messages.
fn siText(_ dims: [Int]) -> String {
    var parts: [String] = []
    let order = [1, 0, 2, 3, 4]
    for k in order {
        let p = dims[k]
        if p == 1 {
            parts.append(dimSymbols[k])
        } else if p != 0 {
            parts.append(dimSymbols[k] + powerText(p))
        }
    }
    parts.joined(separator: "·")
}

fn powerText(_ p: Int) -> String {
    let digits = ["⁰", "¹", "²", "³", "⁴", "⁵", "⁶", "⁷", "⁸", "⁹"]
    var out = ""
    for ch in "{abs(p)}".characters {
        out += digits[Int(ch) ?? 0]
    }
    if p < 0 { "⁻" + out } else { out }
}

// What kind of quantity a dimension is, for messages: "a length", "a
// pressure or stress", or the SI unit for others.
fn dimName(_ dims: [Int]) -> String {
    let key = dims.map { d in "{d}" }.joined(separator: ",")
    let names: [String: String] = [
        "0,0,0,0,0": "a plain number", "1,0,0,0,0": "a length", "2,0,0,0,0": "an area",
        "3,0,0,0,0": "a volume", "0,1,0,0,0": "a mass", "0,0,1,0,0": "a time",
        "1,1,-2,0,0": "a force", "-1,1,-2,0,0": "a pressure or stress", "2,1,-2,0,0": "a moment or energy",
        "2,1,-3,0,0": "a power", "3,0,-1,0,0": "a flow", "1,0,-1,0,0": "a speed", "1,0,-2,0,0": "an acceleration",
        "-3,1,0,0,0": "a density", "-2,1,-2,0,0": "a unit weight", "0,1,-2,0,0": "a force per length",
        "0,0,0,1,0": "a temperature", "0,0,0,0,1": "an angle", "0,0,-1,0,0": "a frequency",
        "4,0,0,0,0": "a second moment of area"]
    names[key] ?? "a quantity in {siText(dims)}"
}
